---
/**
 * Seitenkopf für Unterseiten: Label, H1 (mit <em>-Akzent), Lead
 * + glasierte Fliesenkomposition (CSS), die sich beim Laden Fliese für Fliese legt.
 */
interface Props {
  label: string;
  title: string;
  lead?: string;
}
const { label, title, lead } = Astro.props;

// Muster je Seite deterministisch aus dem Label
const glazes = ['#0b1f58', '#0a1747', '#142a6e', '#1d3c8f', '#6eaace', '#bcd4e6', '#e8e4dc', '#0b1f58'];
let seed = [...label].reduce((a, c) => a + c.charCodeAt(0) * 31, 7);
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const tiles = Array.from({ length: 12 }, (_, i) => ({ c: glazes[Math.floor(rnd() * glazes.length)], d: (i % 4) + Math.floor(i / 4) }));
---

<section class="intro">
  <div class="wrap intro-grid">
    <div class="intro-text">
      <p class="label intro-label">{label}</p>
      <h1 class="display intro-title" set:html={title} />
      {lead && <p class="lead intro-lead">{lead}</p>}
      <slot />
    </div>
    <div class="intro-tiles" aria-hidden="true" data-intro-tiles>
      {tiles.map((t) => <i style={`--c:${t.c};--d:${t.d}`} />)}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-intro-tiles]').forEach((wall) => {
    wall.addEventListener('pointermove', (e) => {
      const r = wall.getBoundingClientRect();
      wall.style.setProperty('--mx', `${e.clientX - r.left}px`);
      wall.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });
</script>

<style>
  .intro {
    padding-top: clamp(2.5rem, 8vh, 6rem);
    padding-bottom: var(--space-l);
  }
  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: var(--space-m) var(--space-l);
    align-items: end;
  }
  .intro-text {
    display: grid;
    gap: 1.5rem;
  }
  .intro-title {
    font-size: clamp(2.8rem, 1.4rem + 5.6vw, 7.6rem);
    max-width: 13ch;
  }
  .intro-lead {
    max-width: 36em;
  }

  .intro-tiles {
    --mx: -999px;
    --my: -999px;
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 5px;
    padding: 5px;
    background: var(--grout);
    perspective: 900px;
  }
  .intro-tiles::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(220px circle at var(--mx) var(--my), rgb(255 255 255 / 0.35), transparent 60%);
    mix-blend-mode: soft-light;
  }
  .intro-tiles i {
    aspect-ratio: 1;
    border-radius: 3px;
    background:
      radial-gradient(120% 90% at 30% 20%, rgb(255 255 255 / 0.25), transparent 55%),
      linear-gradient(160deg, color-mix(in srgb, var(--c) 80%, white) 0%, var(--c) 48%, color-mix(in srgb, var(--c) 72%, black) 100%);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.14),
      inset 0 -6px 14px rgb(0 0 0 / 0.22);
    transition: transform 0.6s var(--ease);
  }
  .intro-tiles i:hover {
    transform: translateZ(18px) rotateX(6deg);
  }

  :global(html.motion) .intro-label,
  :global(html.motion) .intro-title,
  :global(html.motion) .intro-lead {
    animation: intro-in 1s var(--ease) both;
  }
  :global(html.motion) .intro-title {
    animation-delay: 0.08s;
  }
  :global(html.motion) .intro-lead {
    animation-delay: 0.2s;
  }
  :global(html.motion) .intro-tiles i {
    animation: tile-lay 0.9s var(--ease) both;
    animation-delay: calc(0.25s + var(--d) * 70ms);
  }
  @keyframes intro-in {
    from {
      opacity: 0;
      transform: translate3d(0, 22px, 0);
    }
  }
  @keyframes tile-lay {
    from {
      opacity: 0;
      transform: translate3d(0, -18px, 40px) rotateX(-35deg) scale(0.9);
    }
  }
  @media (max-width: 900px) {
    .intro-grid {
      grid-template-columns: 1fr;
    }
    .intro-tiles {
      grid-template-columns: repeat(6, 1fr);
      order: -1;
      margin-inline: calc(-1 * var(--pad));
    }
    .intro-tiles i:nth-child(n + 7) {
      display: none;
    }
  }
</style>
