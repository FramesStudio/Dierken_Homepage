---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Raumreise from '../components/Raumreise.astro';
import MaterialViewer from '../components/MaterialViewer.astro';
import Services from '../components/Services.astro';
import Handwerk from '../components/Handwerk.astro';
import Visit from '../components/Visit.astro';
---

<Base
  title="Dierken Bau und Fliesen GmbH – Fliesenausstellung, Beratung & Verlegung in Lohne"
  description="Fliesenausstellung in Lohne: persönliche Beratung, großes Sortiment namhafter Hersteller und fachgerechte Verlegung aus einer Hand. Familienbetrieb seit 1985."
  path="/"
  headerOverlay
>
  <Hero />
  <Raumreise />
  <MaterialViewer />
  <Services />
  <Handwerk />
  <Visit />
</Base>
