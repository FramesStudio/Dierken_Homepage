---
import Logo from './Logo.astro';
import { nav, company, hours } from '../data/site';

interface Props {
  /** Header liegt transparent über einem dunklen Hero */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class:list={['site-header', { 'site-header--overlay': overlay }]} data-header>
  <div class="bar wrap">
    <a href="/" class="brand" aria-label="Dierken Bau und Fliesen – zur Startseite">
      <Logo height={40} />
    </a>

    <nav class="nav" aria-label="Hauptnavigation">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="call" href={company.phoneHref}>
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"
        ><path
          d="M3.6 1.5h2.2l1.1 3.1-1.5 1.1a8.4 8.4 0 0 0 4.9 4.9l1.1-1.5 3.1 1.1v2.2c0 .8-.7 1.5-1.5 1.5A12.9 12.9 0 0 1 2.1 3c0-.8.7-1.5 1.5-1.5Z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.3"
          stroke-linejoin="round"></path></svg
      >
      <span>{company.phone}</span>
    </a>

    <button class="burger" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
      <span class="sr-only">Menü</span>
      <span class="burger-lines" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>

  <div class="menu on-navy" id="menu" hidden data-menu>
    <nav class="menu-nav wrap" aria-label="Mobile Navigation">
      <ul role="list">
        <li style="--i:0"><a href="/">Start</a></li>
        {
          nav.map((item, i) => (
            <li style={`--i:${i + 1}`}>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="menu-meta">
        <a class="btn btn--light" href={company.phoneHref}>Anrufen: {company.phone}</a>
        <p class="small">
          {company.street}, {company.zip} {company.city}<br />
          Ausstellung {hours.weekdayShort} 9–12 &amp; 14–17:30 Uhr · {hours.saturdayShort}
        </p>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    height: var(--header-h);
    background: rgb(244 242 238 / 0);
    transition:
      transform var(--t-mid) var(--ease),
      background-color var(--t-mid) var(--ease),
      box-shadow var(--t-mid) var(--ease);
  }
  .site-header.is-scrolled {
    background: var(--paper);
    box-shadow: 0 1px 0 var(--line);
  }
  .site-header.is-hidden {
    transform: translateY(-100%);
  }
  .site-header--overlay:not(.is-scrolled):not(.menu-open) .nav a,
  .site-header--overlay:not(.is-scrolled):not(.menu-open) .call,
  .site-header--overlay:not(.is-scrolled):not(.menu-open) .burger {
    color: var(--paper);
  }
  /* Über dem Hero steht das große Logo – im Header erst nach dem Scrollen */
  .brand {
    transition: opacity var(--t-mid) var(--ease);
  }
  .site-header--overlay:not(.is-scrolled):not(.menu-open) .brand:not(:focus-visible) {
    opacity: 0;
    pointer-events: none;
  }
  .site-header--overlay:not(.is-scrolled) .call {
    border-color: rgb(242 239 233 / 0.4);
  }
  :global(html.hero-day) .site-header--overlay:not(.is-scrolled):not(.menu-open) :is(.nav a, .call, .burger) {
    color: var(--navy);
  }
  :global(html.hero-day) .site-header--overlay:not(.is-scrolled) .call {
    border-color: var(--line-strong);
  }
  .site-header--overlay:not(.is-scrolled) .call:hover {
    background: var(--paper);
    color: var(--navy);
  }
  .bar {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .brand {
    display: inline-flex;
    flex: none;
  }
  .nav {
    margin-left: auto;
  }
  .nav ul {
    display: flex;
    gap: clamp(1rem, 2vw, 2.25rem);
  }
  .nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--navy);
    text-decoration: none;
    transition: color var(--t-mid) var(--ease);
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--t-mid) var(--ease);
  }
  .nav a:hover::after,
  .nav a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .call {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0 1.1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font-size: 0.88rem;
    font-weight: 650;
    color: var(--navy);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
    transition:
      background-color var(--t-fast) var(--ease),
      color var(--t-fast) var(--ease);
  }
  .call:hover {
    background: var(--navy);
    color: var(--paper);
  }
  .burger {
    display: none;
    margin-left: auto;
    width: 48px;
    height: 48px;
    border: 0;
    background: none;
    cursor: pointer;
    color: var(--navy);
  }
  .burger-lines {
    position: relative;
    display: block;
    width: 26px;
    height: 12px;
    margin: auto;
  }
  .burger-lines span {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: currentColor;
    transition:
      transform var(--t-mid) var(--ease),
      top var(--t-mid) var(--ease);
  }
  .burger-lines span:first-child {
    top: 0;
  }
  .burger-lines span:last-child {
    top: 10px;
    right: 8px;
  }
  .burger[aria-expanded='true'] {
    color: var(--paper);
  }
  .burger[aria-expanded='true'] .burger-lines span {
    top: 5px;
    right: 0;
  }
  .burger[aria-expanded='true'] .burger-lines span:first-child {
    transform: rotate(45deg);
  }
  .burger[aria-expanded='true'] .burger-lines span:last-child {
    transform: rotate(-45deg);
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: -1;
    padding-top: calc(var(--header-h) + 2rem);
    overflow-y: auto;
  }
  .menu[hidden] {
    display: none;
  }
  .menu-nav ul {
    display: grid;
    gap: 0.25rem;
  }
  .menu-nav a:not(.btn) {
    display: block;
    padding: 0.35rem 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 10vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--paper);
    text-decoration: none;
  }
  .menu-nav a[aria-current='page'] {
    font-style: italic;
    color: var(--mist);
  }
  .menu-meta {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-on-navy);
    display: grid;
    gap: 1.25rem;
    color: var(--on-navy-soft);
  }
  :global(html.motion-ready) .menu:not([hidden]) li {
    animation: menu-in var(--t-slow) var(--ease) both;
    animation-delay: calc(80ms + var(--i) * 60ms);
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }
  .site-header.menu-open {
    background: var(--navy);
    box-shadow: none;
  }
  .site-header.menu-open .brand {
    position: relative;
    z-index: 1;
  }

  @media (max-width: 1080px) {
    .call span {
      display: none;
    }
    .call {
      width: 44px;
      padding: 0;
      justify-content: center;
    }
  }
  @media (max-width: 900px) {
    .nav,
    .call {
      display: none;
    }
    .burger {
      display: block;
    }
  }
</style>
